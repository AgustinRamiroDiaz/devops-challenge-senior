# Terraform working directories and local state
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan

# Generated by the Terraform backend Make targets.
terraform/backend_override.tf

# Temporary Application Default Credentials generated by Google auth actions.
gha-creds-*.json

# Local variable files can contain account-specific values.
*.auto.tfvars
*.auto.tfvars.json
terraform/*.tfvars.json
